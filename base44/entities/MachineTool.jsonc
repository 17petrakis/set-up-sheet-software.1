{
  "name": "MachineTool",
  "type": "object",
  "properties": {
    "machine_name": {
      "type": "string",
      "description": "Name of the machine"
    },
    "machine_type": {
      "type": "string",
      "enum": [
        "mill",
        "lathe",
        "saw"
      ],
      "description": "Type of machine"
    },
    "tools": {
      "type": "array",
      "description": "Array of tool objects for mill machines",
      "items": {
        "type": "object"
      }
    },
    "turrets": {
      "type": "array",
      "description": "Array of turret objects for lathe machines",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "machine_name",
    "machine_type"
  ]
}
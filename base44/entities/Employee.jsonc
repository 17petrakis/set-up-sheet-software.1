{
  "name": "Employee",
  "type": "object",
  "properties": {
    "employee_number": {
      "type": "string",
      "description": "Unique employee identifier"
    },
    "full_name": {
      "type": "string",
      "description": "Employee full name"
    },
    "email": {
      "type": "string",
      "description": "Employee email address"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the employee account is active"
    }
  },
  "required": [
    "employee_number"
  ]
}
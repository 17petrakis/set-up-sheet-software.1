{
  "name": "Employee",
  "type": "object",
  "properties": {
    "employeeNumber": {
      "type": "string",
      "description": "Unique employee login number"
    },
    "name": {
      "type": "string",
      "description": "Employee full name"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Whether the employee can access the app"
    }
  },
  "required": [
    "employeeNumber"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
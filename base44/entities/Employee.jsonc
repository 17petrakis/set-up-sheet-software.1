{
  "name": "Employee",
  "type": "object",
  "properties": {
    "employee_number": {
      "type": "string",
      "description": "Employee login number"
    },
    "full_name": {
      "type": "string",
      "description": "Employee full name"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether employee can access the app"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "employee"
      ],
      "default": "employee",
      "description": "Employee role"
    }
  },
  "required": [
    "employee_number",
    "full_name"
  ]
}
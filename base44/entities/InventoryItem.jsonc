{
  "name": "InventoryItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Item name (shown in dropdowns)"
    },
    "category": {
      "type": "string",
      "enum": [
        "machine",
        "cad_software",
        "vise",
        "jaw",
        "cmm_equipment",
        "cmm_post_size"
      ],
      "description": "Inventory section this item belongs to"
    },
    "machine_type": {
      "type": "string",
      "enum": [
        "mill",
        "lathe",
        "cmm"
      ],
      "description": "For machines/jaws: which machine context this item applies to"
    },
    "subgroup": {
      "type": "string",
      "description": "Sub-group within a category (e.g. CMM equipment: Fixturing/Gauges/Other)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disposed"
      ],
      "default": "active",
      "description": "Disposed items drop off dropdowns but remain in existing sheets"
    },
    "tool_capacity": {
      "type": "number",
      "description": "For machines: number of tools the machine can hold"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Variant options (e.g. CMM Base Block: Large/Small)"
    },
    "has_size": {
      "type": "boolean",
      "default": false,
      "description": "Whether this item uses a size field (gauge blocks/pins)"
    },
    "default_sizes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Default size options for size-field items"
    }
  },
  "required": [
    "name",
    "category"
  ]
}
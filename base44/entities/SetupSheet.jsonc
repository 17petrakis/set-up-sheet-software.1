{
  "name": "SetupSheet",
  "type": "object",
  "properties": {
    "machine_type": {
      "type": "string",
      "enum": [
        "milling",
        "turning"
      ],
      "default": "milling",
      "description": "Type of machine: milling or turning"
    },
    "part_number": {
      "type": "string",
      "description": "Part number"
    },
    "part_name": {
      "type": "string",
      "description": "Description / name of the part"
    },
    "revision": {
      "type": "string",
      "description": "Revision"
    },
    "customer": {
      "type": "string",
      "description": "Customer name (used as folder grouping)"
    },
    "job_number": {
      "type": "string"
    },
    "machine": {
      "type": "string"
    },
    "programmer": {
      "type": "string",
      "description": "Machinist / programmer name"
    },
    "date": {
      "type": "string"
    },
    "quantity": {
      "type": "string"
    },
    "material": {
      "type": "string"
    },
    "material_color": {
      "type": "string",
      "description": "Material color (milling)"
    },
    "material_condition": {
      "type": "string",
      "description": "Material condition / heat treatment (milling)"
    },
    "material_color_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether material color field is shown"
    },
    "material_condition_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether material condition field is shown"
    },
    "stock": {
      "type": "string",
      "description": "Stock size / description (turning)"
    },
    "consumed_per_part": {
      "type": "string",
      "description": "Material consumed per part (turning)"
    },
    "program": {
      "type": "string",
      "description": "Program number / name"
    },
    "program_numbers": {
      "type": "object",
      "description": "Multi-program numbers for turning machines with upper/lower turrets"
    },
    "program_software": {
      "type": "string",
      "description": "CAM software used (Mastercam, Gibbscam, etc.)"
    },
    "automation": {
      "type": "string",
      "enum": [
        "Fully",
        "Semi",
        "No"
      ],
      "description": "Level of automation"
    },
    "program_description": {
      "type": "string",
      "description": "What is happening in this operation"
    },
    "has_program_edited": {
      "type": "boolean",
      "default": false,
      "description": "Whether the program was edited at the machine"
    },
    "edit_note": {
      "type": "string",
      "description": "Note describing what was edited at the machine"
    },
    "program_location": {
      "type": "string",
      "description": "Where the program is stored"
    },
    "cycle_time": {
      "type": "string",
      "description": "Machine cycle time (turning)"
    },
    "cycle_time_hrs": {
      "type": "string",
      "description": "Cycle time in hours (milling)"
    },
    "cycle_time_notes": {
      "type": "string",
      "description": "Notes related to cycle time (milling)"
    },
    "handling_time": {
      "type": "string",
      "description": "Handling time including material inspection (turning)"
    },
    "has_deburring": {
      "type": "boolean",
      "default": false,
      "description": "Whether deburring/finishing section is active"
    },
    "deburring_time": {
      "type": "string"
    },
    "finishing_time": {
      "type": "string"
    },
    "wash_time": {
      "type": "string"
    },
    "total_additional_time": {
      "type": "string",
      "description": "Sum of deburring + finishing + wash times"
    },
    "deburring_notes": {
      "type": "string"
    },
    "finishing_notes": {
      "type": "string"
    },
    "wash_notes": {
      "type": "string"
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Process stops list (milling & turning)"
    },
    "operation_description": {
      "type": "string"
    },
    "operation_notes": {
      "type": "string",
      "description": "Operation notes"
    },
    "operation_media": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Media items (photos/videos) for operation notes: [{url, type, title, note}]"
    },
    "work_holding_notes": {
      "type": "string",
      "description": "Work holding notes (milling)"
    },
    "fixturing_notes": {
      "type": "object",
      "description": "Fixturing notes for milling: {fixture, vise, work_holding_notes, photo}"
    },
    "units": {
      "type": "string",
      "enum": [
        "Inch",
        "Metric"
      ],
      "default": "Inch"
    },
    "total_cycle_time": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Tool list"
    },
    "turning_tools": {
      "type": "object",
      "description": "Turning turret tools: {axial: [], radial: []}"
    },
    "part_zero": {
      "type": "object"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "operations_in_view": {
      "type": "boolean",
      "default": false,
      "description": "Whether operations are included in view/print mode"
    },
    "turning_chuck": {
      "type": "object",
      "description": "Chuck & work holding data for turning sheets"
    },
    "citizen_workholding": {
      "type": "object",
      "description": "Citizen swiss-style workholding/part eject data: {bar_loader_collet_size, ms_collet_size, ms_collet_shape, guide_bush_size, guide_bush_shape, guide_bush_material, ss_collet_size, ss_collet_shape, ss_collet_stickout, ss_collet_special, part_ejection_description, part_ejection_photo}"
    },
    "mc_machining_data": {
      "type": "object",
      "description": "MC Machining Data screen: {photo, note}"
    },
    "preparation_screen": {
      "type": "object",
      "description": "Preparation screen: {photo, note}"
    },
    "photos": {
      "type": "object",
      "description": "Photo URLs for work holding, drawing, ISO, material stock, and final part"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Repeating",
        "One Time",
        "Completed",
        "On Hold"
      ],
      "default": "Active",
      "description": "Current job status"
    },
    "folder_id": {
      "type": "string",
      "description": "Groups setup sheets into a part folder."
    },
    "operation_number": {
      "type": "number",
      "description": "Operation sequence number within the folder",
      "default": 1
    },
    "operation_name": {
      "type": "string",
      "description": "Editable name for this operation (e.g. Op 10, Face & Drill)"
    },
    "sort_order": {
      "type": "number",
      "description": "Manual sort order within the folder; defaults to creation time"
    },
    "published": {
      "type": "boolean",
      "default": false,
      "description": "Whether this sheet is published/locked from non-admin edits"
    }
  },
  "required": [
    "part_number"
  ]
}
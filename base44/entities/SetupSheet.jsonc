{
  "name": "SetupSheet",
  "type": "object",
  "properties": {
    "machine_type": {
      "type": "string",
      "enum": [
        "milling",
        "turning"
      ],
      "default": "milling"
    },
    "part_number": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "customer": {
      "type": "string"
    },
    "job_number": {
      "type": "string"
    },
    "machine": {
      "type": "string"
    },
    "programmer": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "quantity": {
      "type": "string"
    },
    "material": {
      "type": "string"
    },
    "stock": {
      "type": "string"
    },
    "consumed_per_part": {
      "type": "string"
    },
    "program": {
      "type": "string"
    },
    "program_software": {
      "type": "string"
    },
    "program_location": {
      "type": "string"
    },
    "cycle_time": {
      "type": "string"
    },
    "handling_time": {
      "type": "string"
    },
    "has_deburring": {
      "type": "boolean",
      "default": false
    },
    "deburring_time": {
      "type": "string",
      "description": "Legacy \u2014 mapped to deburr_time"
    },
    "finishing_time": {
      "type": "string",
      "description": "Legacy \u2014 mapped to finishing_time"
    },
    "total_additional_time": {
      "type": "string"
    },
    "deburring_notes": {
      "type": "string",
      "description": "Legacy"
    },
    "finishing_notes": {
      "type": "string",
      "description": "Legacy"
    },
    "wash_active": {
      "type": "boolean",
      "default": false
    },
    "wash_time": {
      "type": "string"
    },
    "wash_notes": {
      "type": "string"
    },
    "deburr_active": {
      "type": "boolean",
      "default": false
    },
    "deburr_time": {
      "type": "string"
    },
    "deburr_notes": {
      "type": "string"
    },
    "finishing_active": {
      "type": "boolean",
      "default": false
    },
    "operation_description": {
      "type": "string"
    },
    "operation_notes": {
      "type": "string"
    },
    "work_holding_notes": {
      "type": "string"
    },
    "units": {
      "type": "string",
      "enum": [
        "Inch",
        "Metric"
      ],
      "default": "Inch"
    },
    "total_cycle_time": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "turning_tools": {
      "type": "object"
    },
    "part_zero": {
      "type": "object"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "turning_chuck": {
      "type": "object"
    },
    "photos": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Repeating",
        "One Time",
        "Completed",
        "On Hold"
      ],
      "default": "Active"
    },
    "folder_id": {
      "type": "string"
    },
    "operation_number": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "part_number"
  ]
}
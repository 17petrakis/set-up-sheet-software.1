{
  "name": "SetupSheet",
  "type": "object",
  "properties": {
    "part_number": {
      "type": "string",
      "description": "Part number"
    },
    "revision": {
      "type": "string",
      "description": "Revision"
    },
    "customer": {
      "type": "string",
      "description": "Customer name (used as folder grouping)"
    },
    "job_number": {
      "type": "string"
    },
    "machine": {
      "type": "string"
    },
    "programmer": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "quantity": {
      "type": "string"
    },
    "material": {
      "type": "string"
    },
    "operation_description": {
      "type": "string"
    },
    "operation_notes": {
      "type": "string",
      "description": "Operation notes"
    },
    "work_holding_notes": {
      "type": "string",
      "description": "Work holding notes"
    },
    "program": {
      "type": "string"
    },
    "units": {
      "type": "string",
      "enum": [
        "Inch",
        "Metric"
      ],
      "default": "Inch"
    },
    "total_cycle_time": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "part_zero": {
      "type": "object"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "photos": {
      "type": "object",
      "description": "Photo URLs for work holding, drawing, ISO, material stock, and final part"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Repeating",
        "One Time",
        "Completed",
        "On Hold"
      ],
      "default": "Active",
      "description": "Current job status"
    }
  },
  "required": [
    "part_number"
  ]
}
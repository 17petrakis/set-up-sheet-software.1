{
  "name": "SetupSheet",
  "type": "object",
  "properties": {
    "machine_type": {
      "type": "string",
      "enum": [
        "milling",
        "turning"
      ],
      "default": "milling",
      "description": "Type of machine: milling or turning"
    },
    "part_number": {
      "type": "string",
      "description": "Part number"
    },
    "part_name": {
      "type": "string",
      "description": "Description / name of the part"
    },
    "revision": {
      "type": "string",
      "description": "Revision"
    },
    "customer": {
      "type": "string",
      "description": "Customer name (used as folder grouping)"
    },
    "job_number": {
      "type": "string"
    },
    "machine": {
      "type": "string"
    },
    "programmer": {
      "type": "string",
      "description": "Machinist / programmer name"
    },
    "date": {
      "type": "string"
    },
    "quantity": {
      "type": "string"
    },
    "material": {
      "type": "string"
    },
    "stock": {
      "type": "string",
      "description": "Stock size / description (turning)"
    },
    "consumed_per_part": {
      "type": "string",
      "description": "Material consumed per part (turning)"
    },
    "program": {
      "type": "string",
      "description": "Program number / name"
    },
    "program_software": {
      "type": "string",
      "description": "CAM software used (Mastercam, Gibbscam, etc.)"
    },
    "automation": {
      "type": "string",
      "enum": [
        "Fully",
        "Semi",
        "No"
      ],
      "description": "Level of automation"
    },
    "program_description": {
      "type": "string",
      "enum": [
        "Roughing",
        "Finishing",
        "Prep",
        "Complete with transfer"
      ],
      "description": "What is happening in this operation"
    },
    "program_location": {
      "type": "string",
      "description": "Where the program is stored"
    },
    "cycle_time": {
      "type": "string",
      "description": "Machine cycle time (turning)"
    },
    "handling_time": {
      "type": "string",
      "description": "Handling time including material inspection (turning)"
    },
    "has_deburring": {
      "type": "boolean",
      "default": false,
      "description": "Whether deburring/finishing section is active"
    },
    "deburring_time": {
      "type": "string"
    },
    "finishing_time": {
      "type": "string"
    },
    "wash_time": {
      "type": "string"
    },
    "total_additional_time": {
      "type": "string",
      "description": "Sum of deburring + finishing + wash times"
    },
    "deburring_notes": {
      "type": "string"
    },
    "finishing_notes": {
      "type": "string"
    },
    "wash_notes": {
      "type": "string"
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Process stops list (milling & turning)"
    },
    "operation_description": {
      "type": "string"
    },
    "operation_notes": {
      "type": "string",
      "description": "Operation notes"
    },
    "work_holding_notes": {
      "type": "string",
      "description": "Work holding notes (milling)"
    },
    "fixturing_notes": {
      "type": "object",
      "description": "Fixturing notes for milling: {fixture, vise, work_holding_notes, photo}"
    },
    "units": {
      "type": "string",
      "enum": [
        "Inch",
        "Metric"
      ],
      "default": "Inch"
    },
    "total_cycle_time": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Tool list"
    },
    "turning_tools": {
      "type": "object",
      "description": "Turning turret tools: {axial: [], radial: []}"
    },
    "part_zero": {
      "type": "object"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "turning_chuck": {
      "type": "object",
      "description": "Chuck & work holding data for turning sheets"
    },
    "photos": {
      "type": "object",
      "description": "Photo URLs for work holding, drawing, ISO, material stock, and final part"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Repeating",
        "One Time",
        "Completed",
        "On Hold"
      ],
      "default": "Active",
      "description": "Current job status"
    },
    "folder_id": {
      "type": "string",
      "description": "Groups setup sheets into a part folder."
    },
    "operation_number": {
      "type": "number",
      "description": "Operation sequence number within the folder",
      "default": 1
    }
  },
  "required": [
    "part_number"
  ]
}
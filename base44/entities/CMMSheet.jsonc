{
  "name": "CMMSheet",
  "type": "object",
  "properties": {
    "part_number": {
      "type": "string"
    },
    "customer": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "folder_id": {
      "type": "string"
    },
    "machine": {
      "type": "string"
    },
    "material": {
      "type": "string"
    },
    "cycle_time": {
      "type": "string"
    },
    "program_number": {
      "type": "string"
    },
    "program_location": {
      "type": "string"
    },
    "units": {
      "type": "string",
      "enum": [
        "in",
        "mm"
      ],
      "default": "in"
    },
    "fixturing": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "work_placement": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Work placement posts with size and x/y coordinates"
    },
    "work_holding": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "important_notes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "program_notes": {
      "type": "string"
    },
    "general_notes": {
      "type": "string",
      "description": "General notes for the CMM setup sheet"
    },
    "operation_number": {
      "type": "number",
      "description": "Operation sequence number within the folder",
      "default": 1
    },
    "sort_order": {
      "type": "number",
      "description": "Manual sort order within the folder; defaults to creation time"
    },
    "thumbnail_image": {
      "type": "string",
      "description": "URL of the image chosen as the sheet thumbnail (shown on dashboard cards)"
    },
    "is_folder_thumbnail": {
      "type": "boolean",
      "default": false,
      "description": "Whether this sheet's thumbnail is used as the part folder's card image"
    }
  },
  "required": [
    "part_number"
  ]
}
{
  "name": "CMMSheet",
  "type": "object",
  "properties": {
    "part_number": {
      "type": "string"
    },
    "customer": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "folder_id": {
      "type": "string"
    },
    "machine": {
      "type": "string"
    },
    "material": {
      "type": "string"
    },
    "cycle_time": {
      "type": "string"
    },
    "program_number": {
      "type": "string"
    },
    "program_location": {
      "type": "string"
    },
    "units": {
      "type": "string",
      "enum": [
        "in",
        "mm"
      ],
      "default": "in"
    },
    "fixturing": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "work_placement": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Work placement posts with size and x/y coordinates"
    },
    "work_holding": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "important_notes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "program_notes": {
      "type": "string"
    },
    "operation_number": {
      "type": "number",
      "description": "Operation sequence number within the folder",
      "default": 1
    },
    "sort_order": {
      "type": "number",
      "description": "Manual sort order within the folder; defaults to creation time"
    }
  },
  "required": [
    "part_number"
  ]
}